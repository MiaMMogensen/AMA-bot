<!doctype html>
<html lang="da">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>AMAbot</title>
<link rel="stylesheet" href="/styles.css" />
</head>
<body>

<div class="chat">

  <h1>Spørg mig om hvad som helst</h1>

  <div class="chat-messages">
    <% for (const message of messages) { %>
      <article class="message <%= message.type %>">
        <p><%= message.text %></p>
      </article>
    <% } %>

    <% if (error) { %>
      <p role="alert" class="error"><%= error %></p>
    <% } %>

    <div id="answer"></div>
  </div>

  <form method="POST" action="/ask" class="chat-form">
    <label for="question">Stil mig et spørgsmål</label>
    <input id="question" name="question" type="text" autocomplete="off" />
    <button type="submit">Send</button>
  </form>

</div>

</body>
</html>